PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=your-project-id
# Absolute local path. Never commit the service account JSON.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/powergrid-service-account.json
# registered: any signed-in email account in this Firebase project can use the shared system.
# allowlist: only ALLOWED_EMAILS can access it.
ACCESS_MODE=registered
ALLOWED_EMAILS=
# Each registered device has its own random key (at least 32 characters).
DEVICE_KEYS_JSON={"light-a":"replace-with-a-random-key-of-at-least-32-characters"}
